<?xml version="1.0" encoding="UTF-8"?>
<!--
  M7e (A10): the Maven plugin front end. A separate Maven build inside the
  Gradle repo (recorded deviation in ADR 0011): maven-plugin packaging requires
  a Maven build. Depends on org.crazyrock.callis:core published to the local
  repository by `./gradlew :core:publishToMavenLocal`.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.crazyrock.callis</groupId>
  <artifactId>callis-maven-plugin</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>maven-plugin</packaging>

  <name>Callis Maven Plugin</name>
  <description>
    Fails the Maven build when a vulnerability from the project's SBOM is
    reachable from the project's main classes (reachability:check, A10).
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <dependencies>
    <!-- The engine (M7a A10 facade): published by :core:publishToMavenLocal. -->
    <dependency>
      <groupId>org.crazyrock.callis</groupId>
      <artifactId>core</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>3.10.0</version>
      <scope>provided</scope>
    </dependency>
    <!-- The @Mojo/@Parameter annotations are a separate artifact in Maven 3.9.16. -->
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>3.16.0</version>
      <scope>provided</scope>
    </dependency>
    <!-- MavenProject for the goal; maven-artifact (DefaultArtifact) for its tests. -->
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>3.10.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-artifact</artifactId>
      <version>3.10.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- maven-plugin packaging: generates the goal descriptor. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <goalPrefix>reachability</goalPrefix>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
    </plugins>
  </build>
</project>
